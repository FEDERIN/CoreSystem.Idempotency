<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>CoreSystem.Idempotency.PostgreSql</PackageId>

		<Version>2.1.0</Version>
		<AssemblyVersion>2.1.0</AssemblyVersion>
		<FileVersion>2.1.0.0</FileVersion>
		<InformationalVersion>2.1.0</InformationalVersion>

		<PackageReleaseNotes>
			2.1.0: Multi-targeting release. The package now ships net8.0, net9.0 and net10.0 assets instead of net8.0 only, so a project on .NET 9 or .NET 10 gets an assembly compiled for its own target framework.
			Dependency refresh. No code or API changes.
			Dapper 2.1.79 to 2.1.89 and Npgsql 8.0.3 to 8.0.9, plus the refreshed transitive
			graph (Microsoft.Extensions.* and OpenTelemetry.Extensions.Hosting 1.20.0).
		</PackageReleaseNotes>
		<Description>
			Production-ready PostgreSQL storage provider for CoreSystem.Idempotency, providing durable persistence through the IIdempotencyStorage abstraction with Dapper-based data access. Ships an idempotent schema script at scripts/postgres.sql.
		</Description>

		<PackageProjectUrl>https://federin.github.io/CoreSystem.Idempotency/Providers/PostgreSQL/</PackageProjectUrl>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>

		<PackageTags>
			PostgreSQL;
			Dapper;
			Idempotency;
			ASP.NET Core;
			IIdempotencyStorage;
			Storage Provider;
			Distributed Systems;
			OpenTelemetry;
			Cloud Native;
			Relational Database
		</PackageTags>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Dapper" />
	  <PackageReference Include="Npgsql" />
	</ItemGroup>

	<ItemGroup>
		<!-- Ship the DDL so consumers can create the table; the provider does not create schema. -->
		<None Include="scripts\postgres.sql" Pack="true" PackagePath="scripts\" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Core.Idempotency.PostgreSql.UnitTests" />
		<InternalsVisibleTo Include="Core.Idempotency.PostgreSql.IntegrationTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Core.Idempotency\Core.Idempotency.csproj" />
	</ItemGroup>
</Project>
