<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>

		<PackageId>CoreSystem.Idempotency.PostgreSql</PackageId>

		<Version>2.0.2</Version>
		<AssemblyVersion>2.0.2</AssemblyVersion>
		<FileVersion>2.0.2.0</FileVersion>
		<InformationalVersion>2.0.2</InformationalVersion>

		<PackageReleaseNotes>
			Dependency refresh. No code or API changes.
			Dapper 2.1.79 to 2.1.89 and Npgsql 8.0.3 to 8.0.9, plus the refreshed transitive
			graph (Microsoft.Extensions.* and OpenTelemetry.Extensions.Hosting 1.20.0).
		</PackageReleaseNotes>

		<Authors>Federin Pastor Gutierrez Ortiz</Authors>

		<Description>
			Production-ready PostgreSQL storage provider for CoreSystem.Idempotency, providing durable persistence through the IIdempotencyStorage abstraction with Dapper-based data access. Ships an idempotent schema script at scripts/postgres.sql.
		</Description>

		<RepositoryUrl>https://github.com/FEDERIN/CoreSystem.Idempotency</RepositoryUrl>
		<PackageProjectUrl>https://federin.github.io/CoreSystem.Idempotency/Providers/PostgreSQL/</PackageProjectUrl>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>

		<PackageTags>
			PostgreSQL;
			Dapper;
			Idempotency;
			ASP.NET Core;
			IIdempotencyStorage;
			Storage Provider;
			Distributed Systems;
			OpenTelemetry;
			Cloud Native;
			Relational Database
		</PackageTags>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="CoreSystem.Idempotency" />
	  <PackageReference Include="Dapper" />
	  <PackageReference Include="Npgsql" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<!-- Ship the DDL so consumers can create the table; the provider does not create schema. -->
		<None Include="scripts\postgres.sql" Pack="true" PackagePath="scripts\" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Core.Idempotency.PostgreSql.UnitTests" />
		<InternalsVisibleTo Include="Core.Idempotency.PostgreSql.IntegrationTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>
</Project>
