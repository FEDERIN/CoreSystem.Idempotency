<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>

		<PackageId>CoreSystem.Idempotency.PostgreSql</PackageId>

		<Version>2.0.0</Version>
		<AssemblyVersion>2.0.0</AssemblyVersion>
		<FileVersion>2.0.0.0</FileVersion>
		<InformationalVersion>2.0.0</InformationalVersion>

		<Authors>Federin Pastor Gutierrez Ortiz</Authors>

		<Description>
			Production-ready PostgreSQL storage provider for CoreSystem.Idempotency, providing durable persistence through the IIdempotencyStorage abstraction with automatic schema creation and Dapper-based data access.
		</Description>

		<RepositoryUrl>https://github.com/FEDERIN/CoreSystem</RepositoryUrl>
		<PackageProjectUrl>https://federin.github.io/CoreSystem/Idempotency/Providers/PostgreSQL</PackageProjectUrl>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>

		<PackageTags>
			PostgreSQL;
			Dapper;
			Idempotency;
			ASP.NET Core;
			IIdempotencyStorage;
			Storage Provider;
			Distributed Systems;
			OpenTelemetry;
			Cloud Native;
			Relational Database
		</PackageTags>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Dapper" />
	  <PackageReference Include="Npgsql" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core.Idempotency\Core.Idempotency.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Core.Idempotency.PostgreSql.UnitTests" />
		<InternalsVisibleTo Include="Core.Idempotency.PostgreSql.IntegrationTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>
</Project>
