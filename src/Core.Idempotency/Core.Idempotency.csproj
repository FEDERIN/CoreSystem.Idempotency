<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>CoreSystem.Idempotency</PackageId>

		<Version>2.1.0</Version>
		<AssemblyVersion>2.1.0</AssemblyVersion>
		<FileVersion>2.1.0.0</FileVersion>
		<InformationalVersion>2.1.0</InformationalVersion>

		<PackageReleaseNotes>
			2.1.0: Multi-targeting release. The package now ships net8.0, net9.0 and net10.0 assets instead of net8.0 only, so a project on .NET 9 or .NET 10 gets an assembly compiled for its own target framework.
			Dependency refresh. No code or API changes.
			CoreSystem.Observability.Abstractions 1.0.1 to 1.0.2,
			CoreSystem.Serialization 1.2.3 to 1.2.4 and
			OpenTelemetry.Extensions.Hosting 1.19.0 to 1.20.0, plus the refreshed
			transitive graph. The declared dependency floors now match the versions
			the assembly was built and tested against.
		</PackageReleaseNotes>
		<Description>
			Production-ready idempotency framework for ASP.NET Core featuring duplicate suppression, request fingerprinting, response replay, OpenTelemetry integration, and a provider-based storage architecture.
		</Description>

		<PackageProjectUrl>https://federin.github.io/CoreSystem.Idempotency/</PackageProjectUrl>
		
		<PackageTags>
			Idempotency;
			ASP.NET Core;
			Middleware;
			Distributed Systems;
			Duplicate Suppression;
			Request Fingerprinting;
			Response Replay;
			OpenTelemetry;
			Observability;
			Cloud Native;
			Provider Based;
			Distributed APIs
		</PackageTags>
	</PropertyGroup>

  <ItemGroup>
    <Compile Remove="Internal\Capture\**" />
    <EmbeddedResource Remove="Internal\Capture\**" />
    <None Remove="Internal\Capture\**" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="CoreSystem.Http" />
    <PackageReference Include="CoreSystem.Observability.Abstractions" />
    <PackageReference Include="CoreSystem.Serialization" />
	<PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>
	
  <ItemGroup>
	<FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
	
 <ItemGroup>
	 <InternalsVisibleTo Include="Core.Idempotency.UnitTests" />
	 <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
 </ItemGroup>
</Project>
