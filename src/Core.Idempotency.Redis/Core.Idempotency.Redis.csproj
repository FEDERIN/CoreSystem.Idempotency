<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>

		<PackageId>CoreSystem.Idempotency.Redis</PackageId>

		<Version>2.0.0</Version>
		<AssemblyVersion>2.0.0</AssemblyVersion>
		<FileVersion>2.0.0.0</FileVersion>
		<InformationalVersion>2.0.0</InformationalVersion>

		<Authors>Federin Pastor Gutierrez Ortiz</Authors>

		<Description>
			Production-ready Redis storage provider for CoreSystem.Idempotency, providing high-performance distributed persistence through the IIdempotencyStorage abstraction.
		</Description>

		<RepositoryUrl>https://github.com/FEDERIN/CoreSystem</RepositoryUrl>
		<PackageProjectUrl>https://federin.github.io/CoreSystem/Idempotency/Providers/Redis</PackageProjectUrl>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>

		<PackageTags>
			Redis;
			Idempotency;
			ASP.NET Core;
			IIdempotencyStorage;
			Storage Provider;
			Distributed Cache;
			Distributed Systems;
			OpenTelemetry;
			Cloud Native;
			High Performance
		</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CoreSystem.Redis" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core.Idempotency\Core.Idempotency.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE" Pack="true" PackagePath="" />
	</ItemGroup>
	
	<ItemGroup>
		<InternalsVisibleTo Include="Core.Idempotency.Redis.UnitTests" />
		<InternalsVisibleTo Include="Core.Idempotency.Redis.IntegrationTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>

</Project>
