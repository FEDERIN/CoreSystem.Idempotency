<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>CoreSystem.Idempotency.Redis</PackageId>

		<Version>2.1.0</Version>
		<AssemblyVersion>2.1.0</AssemblyVersion>
		<FileVersion>2.1.0.0</FileVersion>
		<InformationalVersion>2.1.0	</InformationalVersion>

		<PackageReleaseNotes>
			2.1.0: Multi-targeting release. The package now ships net8.0, net9.0 and net10.0 assets instead of net8.0 only, so a project on .NET 9 or .NET 10 gets an assembly compiled for its own target framework.
			Dependency refresh. No code or API changes.
			CoreSystem.Redis 1.0.3 to 1.0.4, which raises its own StackExchange.Redis floor
			to 2.13.17, so the central pin moves with it. Also the refreshed transitive graph
			(Microsoft.Extensions.*, OpenTelemetry.Extensions.Hosting 1.20.0).
		</PackageReleaseNotes>
		<Description>
			Production-ready Redis storage provider for CoreSystem.Idempotency, providing high-performance distributed persistence through the IIdempotencyStorage abstraction.
		</Description>
		
		<PackageProjectUrl>https://federin.github.io/CoreSystem.Idempotency/Providers/Redis/</PackageProjectUrl>

		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>

		<PackageTags>
			Redis;
			Idempotency;
			ASP.NET Core;
			IIdempotencyStorage;
			Storage Provider;
			Distributed Cache;
			Distributed Systems;
			OpenTelemetry;
			Cloud Native;
			High Performance
		</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CoreSystem.Idempotency" />
		<PackageReference Include="CoreSystem.Redis" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE" Pack="true" PackagePath="" />
	</ItemGroup>
	
	<ItemGroup>
		<InternalsVisibleTo Include="Core.Idempotency.Redis.UnitTests" />
		<InternalsVisibleTo Include="Core.Idempotency.Redis.IntegrationTests" />
		<InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
	</ItemGroup>
</Project>
