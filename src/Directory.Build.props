<Project>
	<Import Project="$(MSBuildThisFileDirectory)..\Directory.Build.props" />

	<PropertyGroup>
		<!-- Package metadata -->
		<Authors>Federin Pastor Gutierrez Ortiz</Authors>
		<RepositoryUrl>https://github.com/FEDERIN/CoreSystem.Idempotency</RepositoryUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>

		<!-- Build configuration -->
		<OutputType>Library</OutputType>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>

		<!-- Documentation and packaging -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>
	<ItemGroup>
		<!--
			PackageReadmeFile names README.md inside the package, so the packed
			file must be the README of the project being packed, not the one at
			the repository root. Using MSBuildThisFileDirectory here would put
			the root README inside every package.
		-->
		<None Include="$(MSBuildProjectDirectory)\README.md"
			  Pack="true"
			  PackagePath="\" />

		<None Include="$(MSBuildThisFileDirectory)..\LICENSE"
			  Pack="true"
			  PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
		<!-- PrivateAssets: SourceLink is a build-time concern and must never become
         a nuspec dependency of the published packages. -->
		<PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
	</ItemGroup>
</Project>